{
  "name": "gsc-mcp-remote",
  "version": "3.4.0",
  "description": "Google Search Console MCP server for Claude \u2014 connect by URL at https://gsc.k-o.pro/mcp and sign in with Google, or run it locally. 33 SEO analysis tools across every property in your account: quick wins, traffic-drop diagnosis, content decay, cannibalisation, CTR opportunities, multi-site dashboards and a full image-search suite. Per-user MCP OAuth (PKCE, DCR) so a team shares one deployment and each person sees only their own properties.",
  "main": "dist/index.js",
  "bin": {
    "gsc-mcp-remote": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodotpro/gsc-mcp-remote.git"
  },
  "homepage": "https://gsc.k-o.pro",
  "bugs": {
    "url": "https://github.com/kodotpro/gsc-mcp-remote/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-tools.mjs && node scripts/check-http.mjs && node scripts/check-oauth.mjs && node scripts/check-hardening.mjs",
    "try:oauth": "node scripts/try-oauth-local.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "remote-mcp-server",
    "mcp-oauth",
    "mcp-connector",
    "google-search-console",
    "google-search-console-mcp",
    "search-console-mcp",
    "gsc-mcp",
    "gsc",
    "seo",
    "seo-mcp",
    "seo-tools",
    "search-analytics",
    "image-seo",
    "claude",
    "claude-mcp",
    "model-context-protocol",
    "anthropic",
    "multi-property",
    "streamable-http",
    "self-hosted"
  ],
  "author": "Oleksii Khoroshun",
  "contributors": [
    "Suganthan Mohanadasan (original author, https://suganthan.com)"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "image-size": "^2.0.2",
    "node-html-parser": "^9.0.1",
    "open": "^10.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  }
}
