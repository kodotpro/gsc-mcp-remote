node_modules/
.env

# macOS finder metadata, created in any directory the Finder opens.
.DS_Store

# Build output. Upstream commits dist/ so its .mcpb desktop bundle can be
# packed without a compile step; this fork builds from source instead, which
# keeps diffs readable. Run `npm run build` before packing a bundle.
dist/

# Deployment secrets and state. Never commit these: data/ holds the live
# Google OAuth token, secrets/ the client secrets (.env is covered above).
data/
secrets/
*.json
!package.json
!package-lock.json
!tsconfig.json
*.mcpb
!manifest.json
demo-mock/
probe-platform-properties.mjs
