# Copy to .env on the server and fill in. .env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Bearer token: the only thing between the public internet and your Search
# Console data. Generate with:  openssl rand -hex 32
# Minimum 24 characters or the server refuses to start.
# ---------------------------------------------------------------------------
GSC_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# Google auth. Paths are container paths, not host paths.
#
# oauth mode reuses a token you minted on a machine with a browser and copied
# to ./data/.gsc-mcp/oauth-token.json — the refresh happens headlessly from
# then on. The server itself can never complete an interactive OAuth flow,
# because that needs a browser on the same machine.
# ---------------------------------------------------------------------------
GSC_AUTH_MODE=oauth
GSC_OAUTH_SECRETS_FILE=/secrets/client_secret.json

# readonly keeps the credential unable to submit URLs or change sitemaps.
# Recommended for a hosted deployment.
GSC_SCOPES=readonly

# Alternative to oauth: a service account added as a user to each property.
# GSC_AUTH_MODE=service_account
# GSC_KEY_FILE=/secrets/service-account.json

# ---------------------------------------------------------------------------
# Properties
#
# Deliberately left unset: every tool call then names its own property via
# site_url, and clients discover them with list_properties. Set it only if you
# want one property to be the implicit default.
# ---------------------------------------------------------------------------
# GSC_SITE_URL=sc-domain:example.com

# Feeds multi_site_dashboard's default list (comma-separated).
# GSC_SITE_URLS=sc-domain:example.com,https://other.example.com/

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Public hostname(s) that may appear in the Host header. Proxied requests are
# rejected with 403 if the hostname is not listed here.
GSC_HTTP_ALLOWED_HOSTS=gsc.k-o.pro

# Host port the container is published on (loopback only).
GSC_HTTP_PORT=8787

# Close sessions idle longer than this (default 30 minutes).
# GSC_HTTP_IDLE_TIMEOUT_MS=1800000

# ---------------------------------------------------------------------------
# Per-user sign-in (OAuth mode) — the public multi-user deployment.
#
# GSC_HTTP_AUTH=oauth turns the server into an MCP OAuth resource+authorization
# server: anyone adds it by URL in their Claude client and signs in with their
# own Google account. GSC_HTTP_TOKEN is then unused. Requires Node 24+
# (the provided Docker image is).
# ---------------------------------------------------------------------------
# GSC_HTTP_AUTH=oauth

# The URL clients reach this server at. Becomes the OAuth issuer, the token
# audience, and the base of the Google callback:
#   <GSC_PUBLIC_URL>/oauth/google/callback  <- register EXACTLY this redirect
#   URI on a Google OAuth client of type "Web application".
# GSC_PUBLIC_URL=https://gsc.example.com

# Google web-client credentials for the sign-in sandwich. Either the pair:
# GSC_GOOGLE_CLIENT_ID=
# GSC_GOOGLE_CLIENT_SECRET=
# ...or reuse GSC_OAUTH_SECRETS_FILE above with a web-client JSON.

# Optional sign-in gates on top of Google's own test-user list (while the app
# is in Testing status, Google already limits sign-in to listed test users).
# GSC_ALLOWED_EMAILS=you@example.com,friend@example.com
# GSC_ALLOWED_EMAIL_DOMAINS=example.com

# Where OAuth state lives (defaults under ~/.gsc-mcp on the data volume):
# GSC_OAUTH_DB_FILE=/data/.gsc-mcp/oauth-server.db
# GSC_VAULT_KEY_FILE=/data/.gsc-mcp/vault.key
